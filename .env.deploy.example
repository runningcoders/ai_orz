# 部署环境变量模板（docker compose）
# 用法：cp .env.deploy.example .env
#
# 注意：与根目录的 .env.example 不是一回事——那份是开发/测试用途
# （DATABASE_URL、SQLX_OFFLINE、TEST_* 模型密钥），本文件才是运行时部署配置。

# === 必填：安全密钥 ===
# 生成方式：openssl rand -hex 32
SECRET_KEY=
JWT_SECRET=

# === 网关（--profile gateway）===
# 对外域名，Caddy 据此自动申请并续期 HTTPS 证书；DNS 需已解析到本机
AI_ORZ_DOMAIN=orz.example.com

# === 联邦（跨组织组网）===
# 自报地址：必须是对外可达的网关域名，两侧节点都要填各自的
# 留空则退化为从 listen_addr 推导（容器/网关场景下不可达）
AI_ORZ_PUBLIC_BASE_URL=https://orz.example.com

# 置于网关后必须 true：取 X-Forwarded-For 最右项作为真实客户端 IP，
# 并按 X-Forwarded-Proto 判定 Cookie Secure
AI_ORZ_TRUST_PROXY=true

# 可选：显式指定 Cookie Secure。留空则跟随上面的 X-Forwarded-Proto 自动判定
AI_ORZ_COOKIE_SECURE=

# === 数据目录 ===
# 默认 bind mount 到仓库所在目录的 ./data（产物可直接查看、用普通工具备份）
# 改成 ai_orz_data 则使用 docker 托管卷（不可直接查看，但免去权限处理）
AI_ORZ_DATA_PATH=./data

# ⚠️ 安全提示：AI_ORZ_BASE_PATH 下的 ai_orz.toml 会固化明文主密钥
# （src/config.rs 首次启动时把 SECRET_KEY / JWT_SECRET 写回配置文件，避免漏传 env 导致数据解不开）。
# 因此 ./data 等同于密钥库：宿主目录设 700、配置文件 600，备份必须加密，切勿提交进 git（/data 已在 .gitignore）。

# === 其他 ===
TZ=Asia/Shanghai
