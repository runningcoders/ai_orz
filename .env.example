# Environment variables for ai_orz
# Copy this file to .env and fill in your values
# .env is gitignored and will NOT be committed

# === sqlx-cli / build ===
DATABASE_URL=sqlite://./.ai_orz/test.db
SQLX_OFFLINE=true

# === Real Model Integration Tests (optional) ===
# Configure these to run `cargo test --test real_model_test -- --ignored`
# Leave unset to skip real model tests (CI-safe)

# Embedding model for vector search tests
TEST_EMBEDDING_PROVIDER_TYPE=openai
TEST_EMBEDDING_MODEL_NAME=text-embedding-3-small
TEST_EMBEDDING_API_KEY=
TEST_EMBEDDING_BASE_URL=

# LLM chat model for agent thinking tests
TEST_LLM_PROVIDER_TYPE=openai
TEST_LLM_MODEL_NAME=gpt-4o
TEST_LLM_API_KEY=
TEST_LLM_BASE_URL=
