#!/bin/bash
# pre-commit 钩子：提交前本地拦截 CI 会挂的 fmt 门禁
# 安装：make hooks（即 git config core.hooksPath .githooks）
# 跳过一次：git commit --no-verify
#
# 说明：实现转发到 scripts/check.sh pre-commit —— 与 CI fmt job、make fmt-check 同一份实现，
#       钩子本身不内联命令，避免「Makefile / 钩子 / CI」三处口径漂移。
#       口径：cargo fmt --all -- --check，workspace 全 crate 覆盖，耗时秒级；
#       只检查模块树内的 .rs 文件（与 cargo fmt 行为一致，孤儿文件 CI 同样不查）。
#       更重的 clippy 门禁放在 pre-push，避免每次提交都触发全量编译。

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

exec ./scripts/check.sh pre-commit
