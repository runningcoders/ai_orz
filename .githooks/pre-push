#!/bin/bash
# pre-push 钩子：push 前本地拦截 CI 会挂的 fmt 门禁
# 安装：make hooks（即 git config core.hooksPath .githooks）
# 跳过一次：git push --no-verify
# 说明：与 CI fmt job 完全同口径（cargo fmt --all -- --check），
#       workspace 全 crate 覆盖，耗时秒级；只检查模块树内的 .rs 文件
#       （与 cargo fmt 行为一致，孤儿文件 CI 同样不查）

set -euo pipefail

echo "== pre-push: fmt-check（跳过本次：git push --no-verify）=="

export PATH="$HOME/.cargo/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

cd "$(git rev-parse --show-toplevel)"

if ! cargo fmt --all -- --check; then
    echo ""
    echo "✗ 格式检查未通过，push 已拦截。运行 make fmt 修复后重试。"
    exit 1
fi

echo "✓ fmt-check 通过"
